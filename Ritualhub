-- =============================================
--   HELPER: Create Toggle Buttons (Mobile size)
-- =============================================
local function createToggle(parent, text, yPos, default, toggleRef)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = default and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(70, 70, 70)
    btn.Text = text .. (default and " ✅" or " ❌")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.Parent = parent
    local toggled = default
    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        btn.BackgroundColor3 = toggled and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(70, 70, 70)
        btn.Text = text .. (toggled and " ✅" or " ❌")
        if toggleRef then _G.Ritual[toggleRef] = toggled end
    end)
    return btn
end

