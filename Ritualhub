--           SEA DETECTION & TWEEN HELPER
-- ============================================================
local function getSea()
    local pos = rootPart.Position
    if pos.X < 1000 and pos.Z < 3000 then return "First Sea" end
    if pos.X > 2000 and pos.Z < 2000 then return "Second Sea" end
    if pos.X > 3000 and pos.Z > 1000 then return "Third Sea" end
    return "Unknown"
end

-- Safe tween to target position (prevents teleport bans)
function tweenTo(pos, speed)
    speed = speed or 150 -- studs per second
    if not rootPart then return end
    local current = rootPart.Position
    local distance = (pos - current).magnitude
    if distance < 5 then return end
    local duration = distance / speed
    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(pos)})
    tween:Play()
    tween.Completed:Wait()
end

