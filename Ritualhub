-- Get nearest enemy (NPCs only)
function getNearestEnemy(range)
    range = range or 500
    local closest, dist = nil, math.huge
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if v.Name ~= player.Name and not game:GetService("Players"):FindFirstChild(v.Name) then
                local hrp = v:FindFirstChild("HumanoidRootPart")
                if hrp and v.Humanoid.Health > 0 then
                    local d = (rootPart.Position - hrp.Position).magnitude
                    if d < dist and d < range then
                        dist = d; closest = v
                    end
                end
            end
        end
    end
    return closest
end

-- Attack target (tween to it first)
function attackTarget(target)
    if not target or not rootPart then return end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if hrp then
        local targetPos = hrp.Position + Vector3.new(0, 5, 2)
        tweenTo(targetPos, 120) -- move smoothly
        wait(0.3)
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        else
            humanoid:StartAttack(0.5)
        end
    end
end

