-- ============================================================
--          HELPER: MODERN TOGGLE BUTTON
-- ============================================================
local function createToggle(parent, text, yPos, default, toggleRef)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 200, 0, 45)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = default and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(50, 50, 80)
    btn.BackgroundTransparency = 0.2
    btn.Text = text .. (default and " ✅" or " ❌")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 1
    btn.BorderColor3 = default and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(100, 80, 200)
    btn.Parent = parent
    btn.MouseEnter:Connect(function() btn.BackgroundTransparency = 0.05 end)
    btn.MouseLeave:Connect(function() btn.BackgroundTransparency = 0.2 end)
    local toggled = default
    if toggleRef then _G.Ritual[toggleRef] = default end
    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        btn.BackgroundColor3 = toggled and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(50, 50, 80)
        btn.BorderColor3 = toggled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(100, 80, 200)
        btn.Text = text .. (toggled and " ✅" or " ❌")
        if toggleRef then _G.Ritual[toggleRef] = toggled end
    end)
    return btn
end

